<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
<CheatEntries>
<CheatEntry><ID>1</ID><Description>"Open HP, Sanity and Curse Editor (Connect / Read / Edit)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not AnnihilatedHP then error("Allow this table Lua script to run, then reopen the table.") end
AnnihilatedHP.show()
{$asm}
[DISABLE]
</AssemblerScript></CheatEntry>
</CheatEntries>
<LuaScript>-- Read-only IL2CPP v39 resolver. No remote threads, runtime API calls or RVA list.
-- Addresses are derived from the installed PE and its adjacent metadata file.
AnnihilatedResolver = (function()
  local R = {}
  local function fail(s) error('IL2CPP resolver: '..s, 0) end
  local function need(ok,s) if not ok then fail(s) end end
  local function uint(s,p,n)
    need(p&gt;=0 and p+n&lt;=#s, 'truncated or invalid binary offset')
    return string.unpack('&lt;I'..n,s,p+1)
  end
  local function cstr(s,p,limit)
    need(p&gt;=0 and p&lt;#s, 'invalid string offset')
    local e=s:find('\0',p+1,true)
    need(e and e-p&lt;=(limit or 4096), 'unterminated string')
    return s:sub(p+1,e-1)
  end
  local function matches(s,pattern,alignment)
    local out,p={},1
    while true do
      local i=s:find(pattern,p,true); if not i then break end
      if not alignment or (i-1)%alignment==0 then out[#out+1]=i-1 end
      p=i+1
    end
    return out
  end
  local function unique(values,label)
    need(#values==1,label..': expected one match, found '..#values)
    return values[1]
  end
  local function width(count) return count&lt;0xFF and 1 or (count&lt;0xFFFF and 2 or 4) end
  local function peFile(s)
    need(s:sub(1,2)=='MZ','GameAssembly.dll is not a PE file')
    local h=uint(s,0x3C,4)
    need(s:sub(h+1,h+4)=='PE\0\0' and uint(s,h+4,2)==0x8664,'expected x86-64 PE')
    local n,opt=uint(s,h+6,2),h+24
    need(uint(s,opt,2)==0x20B and n&gt;0 and n&lt;100,'unsupported PE header')
    local P={data=s,base=uint(s,opt+24,8),size=uint(s,opt+56,4),
      stamp=uint(s,h+8,4),header=h,sections={}}
    local first=opt+uint(s,h+20,2)
    for i=0,n-1 do
      local p=first+40*i
      P.sections[#P.sections+1]={rva=uint(s,p+12,4),size=uint(s,p+16,4),
        raw=uint(s,p+20,4),flags=uint(s,p+36,4)}
    end
    function P.raw(rva)
      for _,v in ipairs(P.sections) do
        if rva&gt;=v.rva and rva&lt;v.rva+v.size then return v.raw+rva-v.rva end
      end
      fail('unmapped PE RVA '..string.format('%X',rva))
    end
    function P.rva(raw)
      for _,v in ipairs(P.sections) do
        if raw&gt;=v.raw and raw&lt;v.raw+v.size then return v.rva+raw-v.raw end
      end
      fail('unmapped PE file offset')
    end
    function P.ptr(va) return uint(s,P.raw(va-P.base),8) end
    function P.executable(rva)
      for _,v in ipairs(P.sections) do
        if rva&gt;=v.rva and rva&lt;v.rva+v.size then return v.flags &amp; 0x20000000 ~= 0 end
      end
      return false
    end
    function P.export(name)
      local er,es=uint(s,opt+112,4),uint(s,opt+116,4)
      need(er&gt;0,'missing PE exports')
      local e=P.raw(er); local count=uint(s,e+24,4)
      need(count&lt;100000,'invalid export table')
      local names,ord,func=P.raw(uint(s,e+32,4)),P.raw(uint(s,e+36,4)),P.raw(uint(s,e+28,4))
      local found={}
      for i=0,count-1 do
        if cstr(s,P.raw(uint(s,names+4*i,4)))==name then
          local ordinal=uint(s,ord+2*i,2)
          need(ordinal&lt;uint(s,e+20,4),'invalid export ordinal')
          local rva=uint(s,func+4*ordinal,4)
          need(not(rva&gt;=er and rva&lt;er+es) and P.executable(rva),'forwarded or invalid '..name)
          found[#found+1]=rva
        end
      end
      return unique(found,'export '..name)
    end
    return P
  end
  local function metadata(s)
    need(uint(s,0,4)==0xFAB11BAF,'invalid metadata magic')
    local version=uint(s,4,4)
    need(version==39,'unsupported metadata version '..version..' (supported: 39); no game memory changed')
    local function section(p)
      local off,size,count=uint(s,p,4),uint(s,p+4,4),uint(s,p+8,4)
      need(off+size&lt;=#s and (p==32 or count==0 or size%count==0),'invalid metadata section')
      return {off=off,size=size,count=count,stride=count&gt;0 and size//count or 0}
    end
    local S={strings=section(32),methods=section(68),fields=section(140),
      generic=section(176),interfaces=section(224),types=section(236),images=section(248),params=section(128)}
    local tw,dw,gw,pw=S.interfaces.stride-4,width(S.types.count),width(S.generic.count),width(S.params.count)
    need(tw==1 or tw==2 or tw==4,'unsupported type index width')
    need(S.types.stride==68+3*tw+gw and S.methods.stride==20+dw+tw+pw+gw and
      S.fields.stride==8+tw and S.params.stride==8+tw and S.images.stride==32+2*dw,'unsupported v39 record layout')
    local M={version=version,types={},sections=S}
    function M.str(i)
      need(i&lt;S.strings.size,'invalid metadata string index')
      return cstr(s,S.strings.off+i)
    end
    for i=0,S.types.count-1 do
      local p=S.types.off+i*S.types.stride
      local starts=p+12+3*tw+gw
      local counts=starts+32
      M.types[i]={index=i,name=M.str(uint(s,p,4)),namespace=M.str(uint(s,p+4,4)),
        byval=uint(s,p+8,tw),fieldStart=uint(s,starts,4),methodStart=uint(s,starts+4,4),
        methodCount=uint(s,counts,2),fieldCount=uint(s,counts+4,2)}
    end
    for i=0,S.images.count-1 do
      local p=S.images.off+i*S.images.stride
      local name=M.str(uint(s,p,4)); local start,count=uint(s,p+8,dw),uint(s,p+8+dw,4)
      need(start+count&lt;=S.types.count,'invalid image type range')
      for j=start,start+count-1 do M.types[j].image=name end
    end
    function M.type(image,ns,name)
      local found={}
      for _,t in pairs(M.types) do
        if t.image==image and t.namespace==ns and t.name==name then found[#found+1]=t end
      end
      return unique(found,'type '..ns..'.'..name)
    end
    function M.method(t,name,argc)
      local found={}
      for i=t.methodStart,t.methodStart+t.methodCount-1 do
        need(i&lt;S.methods.count,'invalid method range')
        local p=S.methods.off+i*S.methods.stride
        if M.str(uint(s,p,4))==name and uint(s,p+S.methods.stride-2,2)==argc then
          need(uint(s,p+4,dw)==t.index,'method owner mismatch')
          -- v39 stores a four-byte return-parameter token before parameterStart.
          local start=uint(s,p+8+dw+tw,pw)
          need(argc==0 or start+argc&lt;=S.params.count,'invalid parameter range')
          local parameters={}
          for j=0,argc-1 do parameters[#parameters+1]=uint(s,S.params.off+(start+j)*S.params.stride+8,tw) end
          found[#found+1]={name=name,token=uint(s,p+S.methods.stride-12,4),
            returns=uint(s,p+4+dw,tw),parameters=parameters,flags=uint(s,p+S.methods.stride-8,2)}
        end
      end
      return unique(found,'method '..t.name..'.'..name)
    end
    function M.fields(t)
      local out={}
      for i=0,t.fieldCount-1 do
        need(t.fieldStart+i&lt;S.fields.count,'invalid field range')
        local p=S.fields.off+(t.fieldStart+i)*S.fields.stride
        out[#out+1]={name=M.str(uint(s,p,4)),index=i,type=uint(s,p+4,tw)}
      end
      return out
    end
    return M
  end
  function R.fromData(binary,meta)
    local P,M=peFile(binary),metadata(meta)
    local runtime='Elringus.Naninovel.Runtime.dll'
    local manager=M.type(runtime,'Naninovel','CustomVariableManager')
    local behaviour=M.type(runtime,'Naninovel','RuntimeBehaviour')
    local filter=M.type('Assembly-CSharp.dll','','CustomVariablePostProcessorService')
    local result={version=M.version,stamp=P.stamp,imageSize=P.size,peHeader=P.header,checks={},layout={}}
    local modules,signatures={},{}
    local function method(t,name,args,returns)
      local definition=M.method(t,name,#args)
      need(definition.flags &amp; 0x10 == 0,'expected an instance method: '..name)
      signatures[#signatures+1]={definition=definition,args=args,returns=returns}
      local token=definition.token; local rid=token &amp; 0xFFFFFF
      need(token&gt;&gt;24==6 and rid&gt;0,'invalid method token')
      if not modules[t.image] then
        local candidates={}
        for _,pos in ipairs(matches(binary,t.image..'\0')) do
          local ok,rva=pcall(P.rva,pos)
          if ok then
            for _,at in ipairs(matches(binary,string.pack('&lt;I8',P.base+rva),8)) do
              local valid,module=pcall(function()
                local count=uint(binary,at+8,8); local tableVA=uint(binary,at+16,8)
                need(count&gt;=rid and count&lt;1000000,'invalid codegen module')
                P.raw(tableVA-P.base); P.raw(tableVA-P.base+8*(count-1))
                return {raw=at,count=count,tableVA=tableVA}
              end)
              if valid then candidates[#candidates+1]=module end
            end
          end
        end
        modules[t.image]=unique(candidates,'codegen module '..t.image)
      end
      local mod=modules[t.image]; need(rid&lt;=mod.count,'method token exceeds module table')
      local tableRVA=mod.tableVA-P.base+8*(rid-1)
      local address=uint(binary,P.raw(tableRVA),8)-P.base
      need(P.executable(address),'method has no executable implementation: '..name)
      result.checks[#result.checks+1]={rva=tableRVA,pointerRVA=address}
      return address
    end
    result.update=method(behaviour,'Update',{},1)
    result.setter=method(manager,'SetVariableValue',{14,14},1)
    result.sanityFilter=method(filter,'NormalizeFixedPartnerSanityValue',{14,14},14)
    result.stringNew=P.export('il2cpp_string_new')
    result.typeInfoCandidates={}
    for _,raw in ipairs(matches(binary,string.pack('&lt;I8',0x20000001 | (manager.byval&lt;&lt;1)),8)) do
      local ok,rva=pcall(P.rva,raw)
      if ok then result.typeInfoCandidates[#result.typeInfoCandidates+1]=rva end
    end
    need(#result.typeInfoCandidates&gt;0,'missing CustomVariableManager type-info usage')
    -- Verify native field offsets from MetadataRegistration, not a build-specific RVA.
    local regs={}
    for _,raw in ipairs(matches(binary,string.pack('&lt;I8',M.sections.types.count),8)) do
      if raw&gt;=80 and raw+32&lt;=#binary and uint(binary,raw+16,8)==M.sections.types.count then
        local ok,reg=pcall(function()
          local typesCount=uint(binary,raw-32,8)
          local typesVA=uint(binary,raw-24,8); local offsetsVA=uint(binary,raw+8,8)
          need(typesCount&gt;manager.byval and typesCount&lt;1000000,'invalid registration count')
          P.raw(typesVA-P.base); P.raw(offsetsVA-P.base)
          local it=P.ptr(typesVA+manager.byval*8)
          need(P.ptr(it)==manager.index and (uint(binary,P.raw(it-P.base)+8,4)&gt;&gt;16)&amp;255==0x12,'type registration mismatch')
          return {types=typesVA,typesCount=typesCount,offsets=offsetsVA}
        end)
        if ok then regs[#regs+1]=reg end
      end
    end
    local reg=unique(regs,'metadata registration')
    local function typeCode(index)
      need(index&lt;reg.typesCount,'invalid signature type index')
      local typeVA=P.ptr(reg.types+index*8)
      return (uint(binary,P.raw(typeVA-P.base)+8,4)&gt;&gt;16)&amp;255
    end
    for _,signature in ipairs(signatures) do
      local definition=signature.definition
      need(typeCode(definition.returns)==signature.returns,'unsupported return type: '..definition.name)
      for i,expected in ipairs(signature.args) do
        need(typeCode(definition.parameters[i])==expected,'unsupported parameter type: '..definition.name)
      end
    end
    local function field(t,name)
      local found={}
      for _,f in ipairs(M.fields(t)) do if f.name==name then found[#found+1]=f end end
      local f=unique(found,'field '..t.name..'.'..name)
      local offsets=P.ptr(reg.offsets+t.index*8)
      return uint(binary,P.raw(offsets-P.base)+f.index*4,4)
    end
    result.layout.managerMap=field(manager,'localVariableMap')
    result.layout.managerPreview=field(manager,'readOnlyEvaluationValues')
    need(result.layout.managerMap&gt;=16 and result.layout.managerMap&lt;0x1000 and result.layout.managerMap%8==0 and
      result.layout.managerPreview&gt;=16 and result.layout.managerPreview&lt;0x1000 and result.layout.managerPreview%8==0,
      'unsupported manager field layout')
    local str=M.type('mscorlib.dll','System','String')
    need(field(str,'_stringLength')==0x10 and field(str,'_firstChar')==0x14,'unsupported string layout')
    -- Generic templates do not contain inflated field offsets. Verify the schema,
    -- then validate the actual objects/array stride before accepting a manager.
    local function schema(t,expected)
      local actual={}; for _,f in ipairs(M.fields(t)) do actual[#actual+1]=f.name end
      need(table.concat(actual,',')==expected,'unsupported generic layout: '..t.name)
    end
    schema(M.type(runtime,'Naninovel','SerializableMap`2'),'keys,values,dictionary')
    schema(M.type('mscorlib.dll','System.Collections.Generic','Dictionary`2'),
      '_buckets,_entries,_count,_freeList,_freeCount,_version,_comparer,_keys,_values,_syncRoot')
    result.layout.mapDictionary=0x20; result.layout.dictEntries=0x18
    result.layout.dictCount=0x20; result.layout.dictVersion=0x2C; result.layout.entrySize=24
    -- Match only exact x64 hook instructions that our trampoline replays.
    local function check(rva,bytes,label)
      local raw=P.raw(rva)
      need(binary:sub(raw+1,raw+#bytes)==bytes,'unsupported '..label..' prologue; no hook installed')
    end
    check(result.update,'\x48\x8B\x49\x20\x48\x85\xC9','Update')
    check(result.sanityFilter,'\x48\x89\x5C\x24\x08','sanity filter')
    for _,key in ipairs({'update','setter','stringNew','sanityFilter'}) do
      local rva=result[key]; local raw=P.raw(rva)
      result.checks[#result.checks+1]={rva=rva,bytes=binary:sub(raw+1,raw+16)}
    end
    return result
  end
  function R.resolve(base,modulePath)
    need(type(modulePath)=='string' and #modulePath&gt;0,'module file path unavailable; attach locally to the Proton game')
    local function read(path)
      local f,err=io.open(path,'rb'); need(f~=nil,'cannot open '..path..': '..tostring(err))
      local s=f:read('*a'); f:close(); need(s~=nil,'cannot read '..path); return s
    end
    local dir=modulePath:match('^(.*[/\\])')
    need(dir~=nil,'module path must be absolute')
    local sep=dir:find('\\',1,true) and '\\' or '/'
    local metaPath=dir..table.concat({'Annihilated_Data','il2cpp_data','Metadata','global-metadata.dat'},sep)
    local result=R.fromData(read(modulePath),read(metaPath))
    local function live(rva,n)
      local bytes=readBytes(base+rva,n,true)
      need(bytes and #bytes==n,'cannot read target memory; check process access')
      return string.char(table.unpack(bytes))
    end
    need(uint(live(result.peHeader+8,4),0,4)==result.stamp and
      uint(live(result.peHeader+24+56,4),0,4)==result.imageSize,'disk DLL and running game differ; restart the game')
    for _,c in ipairs(result.checks) do
      if c.bytes then need(live(c.rva,#c.bytes)==c.bytes,'live code differs from disk; disconnect other hooks/restart the game')
      else need(uint(live(c.rva,8),0,8)==base+c.pointerRVA,'live method table differs from disk') end
    end
    result.modulePath=modulePath
    return result
  end
  return R
end)()

-- Annihilated: resolve named IL2CPP methods for the installed game build.
-- Embedded in the .CT; no external Lua file is needed by the delivered table.
-- Only the main-thread bridge calls SetVariableValue. No string is edited in place.
if AnnihilatedHP then
  AnnihilatedHP.disconnect()
  if AnnihilatedHP.timer then AnnihilatedHP.timer.destroy() end
  if AnnihilatedHP.form then AnnihilatedHP.form.destroy() end
end
local M = { fields={}, ordered={}, cache={}, connected=false }
AnnihilatedHP = M
local Resolver = AnnihilatedResolver
local UPDATE, SETTER, STRING_NEW, SANITY_FILTER
local SANITY_ORIGINAL = {0x48,0x89,0x5C,0x24,0x08}
local ORIGINAL = {0x48,0x8B,0x49,0x20,0x48,0x85,0xC9}
local function hex(n) return string.format('%X', n) end
local function pointer(a) return readQword(a) or 0 end
local function text(p)
  if not p or p==0 then return nil end
  local n=readInteger(p+0x10)
  if not n or n&lt;0 or n&gt;2048 then return nil end
  if n==0 then return '' end
  return readString(p+0x14, n*2, true)
end
local function sameBytes(address, expected)
  local actual=readBytes(address,#expected,true)
  if not actual then return false end
  for i=1,#expected do if expected[i]~=actual[i] then return false end end
  return true
end
local function put(ok) if not ok then error('Write failed. Check Cheat Engine process access.') end end
local function runtimeClass(namespace,name)
  local klass=mono_findClass(namespace,name)
  if not klass or klass==0 or mono_class_getName(klass)~=name or mono_class_getNamespace(klass)~=namespace then
    error('Could not locate runtime class '..namespace..'.'..name..'. This game update may need a table update.')
  end
  return klass
end
local function verifyFields(klass,expected)
  if not klass or klass==0 then error('Invalid runtime class while checking the variable layout.') end
  local fields=mono_class_enumFields(klass,true)
  if not fields then error('Could not read the runtime field layout.') end
  for name,offset in pairs(expected) do
    local matches=0
    for _,field in ipairs(fields) do
      if field.name==name and not field.isStatic and field.offset==offset then matches=matches+1 end
    end
    if matches~=1 then error('The game changed the layout of '..name..'. Writing is disabled; this table needs an update.') end
  end
end
local function executableAddress(address,name)
  if type(address)~='number' or address&lt;M.base or address&gt;=M.base+M.imageSize then
    error('The runtime returned an invalid address for '..name..'.')
  end
  for _,section in ipairs(M.codeSections) do
    if address&gt;=section.first and address&lt;section.last then return address end
  end
  error('The runtime address for '..name..' is not executable game code.')
end
local function runtimeMethod(klass,name,parameterTypes,returnType)
  local methods=mono_class_enumMethods(klass,false)
  if not methods then error('Could not enumerate runtime methods.') end
  local matches={}
  for _,method in ipairs(methods) do
    if method.name==name and method.flags and (method.flags &amp; 0x10)==0 then
      local signature=mono_method_get_parameters(method.method)
      local valid=signature and signature.returntype==returnType and #signature.parameters==#parameterTypes
      if valid then
        for i,t in ipairs(parameterTypes) do if signature.parameters[i].type~=t then valid=false; break end end
      end
      if valid then matches[#matches+1]=method.method end
    end
  end
  if #matches~=1 then error('Could not uniquely identify '..name..' with the required signature. Writing is disabled.') end
  return executableAddress(mono_compile_method(matches[1]),name)
end
function M.discoverRuntime()
  local required={'LaunchMonoDataCollector','mono_isil2cpp','mono_findClass','mono_class_getName',
    'mono_class_getNamespace','mono_class_enumFields','mono_class_enumMethods','mono_method_get_parameters',
    'mono_compile_method','mono_class_getArrayElementClass','mono_array_element_size'}
  for _,name in ipairs(required) do
    if type(_G[name])~='function' then error("Use a full 64-bit Cheat Engine installation with its built-in Mono/IL2CPP support.") end
  end
  M.status('Finding game classes and functions. Please wait...')
  local loaded=LaunchMonoDataCollector()
  local isIl2Cpp=loaded and loaded~=0 and mono_isil2cpp()
  -- CE can retain an attached PID after its collector connection has gone stale.
  -- Reset that CE-side connection once; a definite non-IL2CPP result is rejected.
  if loaded and loaded~=0 and isIl2Cpp==nil and type(libmono)=='table' and type(libmono.terminate)=='function' then
    libmono.terminate()
    loaded=LaunchMonoDataCollector()
    isIl2Cpp=loaded and loaded~=0 and mono_isil2cpp()
  end
  if not loaded or loaded==0 or not isIl2Cpp then error('Could not inspect the IL2CPP runtime. Load a save and reconnect; restart Cheat Engine if needed.') end
  local peOffset=readInteger(M.base+0x3C)
  if not peOffset or peOffset&lt;0x40 or peOffset&gt;0x1000 then error('Invalid GameAssembly module header.') end
  local pe=M.base+peOffset
  if readInteger(pe)~=0x4550 or readSmallInteger(pe+4)~=0x8664 or readSmallInteger(pe+24)~=0x20B then
    error('This table requires a Windows x64 game build.')
  end
  M.imageSize=readInteger(pe+24+56)
  local count,optionalSize=readSmallInteger(pe+6),readSmallInteger(pe+20)
  if not M.imageSize or M.imageSize&lt;=0 or not count or count&lt;1 or count&gt;96 or not optionalSize then error('Invalid game code layout.') end
  M.codeSections={}
  for i=0,count-1 do
    local at=pe+24+optionalSize+i*40
    local size,rva,flags=readInteger(at+8),readInteger(at+12),readInteger(at+36)
    if not size or not rva or not flags or rva+size&gt;M.imageSize then error('Invalid game section.') end
    if (flags &amp; 0x20000000)~=0 then
      M.codeSections[#M.codeSections+1]={first=M.base+rva,last=M.base+rva+size}
    end
  end
  local manager=runtimeClass('Naninovel','CustomVariableManager')
  local behaviour=runtimeClass('Naninovel','RuntimeBehaviour')
  local normalizer=runtimeClass('','CustomVariablePostProcessorService')
  verifyFields(manager,{localVariableMap=0x38,readOnlyEvaluationValues=0x40})
  verifyFields(behaviour,{OnBehaviourUpdate=0x20})
  verifyFields(runtimeClass('Naninovel','SerializableLiteralStringMap'),{dictionary=0x20})
  verifyFields(runtimeClass('System','String'),{_stringLength=0x10,_firstChar=0x14})
  -- IL2CPP type IDs: 1 = void, 14 = string. Require instance methods and exact signatures.
  local update=runtimeMethod(behaviour,'Update',{},1)
  local setter=runtimeMethod(manager,'SetVariableValue',{14,14},1)
  local sanity=runtimeMethod(normalizer,'NormalizeFixedPartnerSanityValue',{14,14},14)
  local stringNew=executableAddress(getAddressSafe('GameAssembly.il2cpp_string_new'),'il2cpp_string_new')
  if not sameBytes(update,ORIGINAL) or not sameBytes(sanity,SANITY_ORIGINAL) then
    error('The game function entries changed or another table modified them. Disconnect other tables; if this persists, an update is needed.')
  end
  M.klass=manager
  UPDATE,SETTER,STRING_NEW,SANITY_FILTER=update-M.base,setter-M.base,stringNew-M.base,sanity-M.base
  M.build={update=UPDATE,setter=SETTER,stringNew=STRING_NEW,sanityFilter=SANITY_FILTER,
    peHeader=peOffset,stamp=readInteger(pe+8),imageSize=M.imageSize,
    layout={managerMap=0x38,managerPreview=0x40,mapDictionary=0x20,dictEntries=0x18,dictCount=0x20,dictVersion=0x2C,entrySize=24}}
  M.discovery='runtime'
end
function M.verifyContainers(manager)
  local map=pointer(manager+0x38)
  local dict=pointer(map+0x20)
  local entries=pointer(dict+0x18)
  if map==0 or dict==0 or entries==0 then error('The variable map is not initialized. Load a save first.') end
  verifyFields(pointer(map),{dictionary=0x20})
  verifyFields(pointer(dict),{_entries=0x18,_count=0x20,_version=0x2C})
  local arrayClass=pointer(entries)
  if mono_array_element_size(arrayClass)~=24 then error('The dictionary entry size changed. Writing is disabled.') end
  local entryClass=mono_class_getArrayElementClass(arrayClass)
  -- Metadata offsets include the boxed value-type header; array entries are unboxed.
  verifyFields(entryClass,{hashCode=0x10,next=0x14,key=0x18,value=0x20})
end
local function fieldName(s)
  return s=='playerHealth' or s=='playerMaxHealth' or s=='partnerHealth' or s=='partnerMaxHealth'
    or s=='playerSanity' or s=='partnerSanity' or s=='curse'
    or (s and (s:match('^enemy%d+Health$') or s:match('^enemy%d+MaxHealth$')))
end
local function order(s)
  local known={playerHealth=1,playerMaxHealth=2,playerSanity=3,partnerHealth=4,partnerMaxHealth=5,partnerSanity=6,curse=7}
  return known[s] or (10+tonumber(s:match('enemy(%d+)'))*2+(s:find('Max') and 1 or 0))
end
function M.status(s) M.message=s; if M.statusLabel then M.statusLabel.Caption=s end end
local function gameModule()
  for _,mod in ipairs(enumModules()) do
    local name=(mod.Name or mod.PathToFile or ''):gsub('\\','/'):match('([^/]+)$')
    if name and name:lower()=='gameassembly.dll' then return mod end
  end
end
local function classIs(klass,name,namespace)
  return klass&gt;=0x10000 and readString(pointer(klass+0x10),128,false)==name
    and readString(pointer(klass+0x18),128,false)==namespace
end
local function classInherits(klass,name,namespace)
  local seen={}
  for depth=1,8 do
    if klass&lt;0x10000 or seen[klass] then return false end
    if classIs(klass,name,namespace) then return true end
    seen[klass]=true; klass=pointer(klass+0x58)
  end
  return false
end
function M.checkProcess()
  if not M.pid or getOpenedProcessID()~=M.pid then
    error('CE switched targets. Reconnect to Annihilated.exe.')
  end
  local mod=gameModule()
  if not mod or mod.Address~=M.base or not M.build
    or readInteger(M.base+M.build.peHeader+8)~=M.build.stamp
    or readInteger(M.base+M.build.peHeader+24+56)~=M.build.imageSize then
    error('The game exited or its module changed. Reconnect to Annihilated.exe.')
  end
end
-- Metadata v39 has this class/FieldInfo layout. If reflection fields are already
-- populated, cross-check the inflated generic offsets as well as object contents.
local function fieldOffsetsAgree(klass,expected)
  local remaining={}; for name,offset in pairs(expected) do remaining[name]=offset end
  for depth=1,8 do
    if klass==0 then break end
    local fields=pointer(klass+0x80)
    local count=readSmallInteger(klass+0x124)
    if fields~=0 and count and count&gt;=0 and count&lt;1000 then
      for i=0,count-1 do
        local f=fields+i*0x20
        local name=readString(pointer(f),128,false)
        if name and remaining[name] then
          if readInteger(f+0x18)~=remaining[name] then return false end
          remaining[name]=nil
        end
      end
    end
    klass=pointer(klass+0x58)
  end
  -- IL2CPP may initialize reflection metadata lazily. In that case the resolver's
  -- declared-field schema plus class/stride/content checks below are mandatory.
  return true
end
function M.readRuntimeFields(manager, force)
  if pointer(manager)~=M.klass then return nil end
  local map=pointer(manager+0x38)
  local dict=map~=0 and pointer(map+0x20) or 0
  local entries=dict~=0 and pointer(dict+0x18) or 0
  local count=dict~=0 and readInteger(dict+0x20) or nil
  if entries==0 or not count or count&lt;1 or count&gt;20000 then return nil end
  local capacity=pointer(entries+0x18)
  if capacity&lt;count or capacity&gt;50000 then return nil end
  local version=readInteger(dict+0x2C)
  -- Re-enumerate keys after load, resize or dictionary mutation.
  if force or M.cache.dict~=dict or M.cache.count~=count or M.cache.entries~=entries or M.cache.version~=version or M.cache.manager~=manager then
    local fields={}
    for i=0,count-1 do
      local at=entries+0x20+i*24
      local hash=readInteger(at)
      if hash and hash&gt;=0 and hash&lt;0x80000000 then
        local keyPtr=pointer(at+8)
        local key=text(keyPtr)
        if fieldName(key) then
          if fields[key] then return nil end
          fields[key]={name=key,index=i,key=keyPtr,slot=at+16}
        end
      end
    end
    M.cache={dict=dict,count=count,entries=entries,version=version,manager=manager,fields=fields}
  end
  local fields=M.cache.fields
  if not fields.playerHealth then return nil end
  for _,f in pairs(fields) do
    if pointer(f.slot-8)~=f.key or text(f.key)~=f.name then M.cache={}; return nil end
    f.object=pointer(f.slot); f.value=text(f.object)
  end
  if not fields.playerMaxHealth or not fields.playerSanity or not fields.curse
    or not tonumber(fields.playerHealth.value) or not tonumber(fields.playerMaxHealth.value)
    or not tonumber(fields.playerSanity.value) or not tonumber(fields.curse.value) then return nil end
  if pointer(manager+0x38)~=map or pointer(map+0x20)~=dict or pointer(dict+0x18)~=entries
    or readInteger(dict+0x20)~=count or readInteger(dict+0x2C)~=version then M.cache={}; return nil end
  return fields
end
function M.readFields(manager, force)
  if M.discovery=='runtime' then return M.readRuntimeFields(manager,force) end
  if not manager or pointer(manager)~=M.klass then return nil end
  local L=M.build.layout
  local map=pointer(manager+L.managerMap)
  if map==0 or not classIs(pointer(map),'SerializableLiteralStringMap','Naninovel') then return nil end
  if not fieldOffsetsAgree(pointer(map),{dictionary=L.mapDictionary}) then return nil end
  local dict=pointer(map+L.mapDictionary)
  if dict==0 or not classInherits(pointer(dict),'Dictionary`2','System.Collections.Generic') then return nil end
  if not fieldOffsetsAgree(pointer(dict),{_entries=L.dictEntries,_count=L.dictCount,_version=L.dictVersion}) then return nil end
  local entries=pointer(dict+L.dictEntries)
  local count=readInteger(dict+L.dictCount)
  if entries==0 or not count or count&lt;1 or count&gt;20000 then return nil end
  local capacity=pointer(entries+0x18)
  if capacity&lt;count or capacity&gt;50000 or readInteger(pointer(entries)+0x104)~=L.entrySize then return nil end
  local version=readInteger(dict+L.dictVersion)
  if version==nil then return nil end
  if force or M.cache.dict~=dict or M.cache.entries~=entries or M.cache.count~=count
    or M.cache.version~=version or M.cache.manager~=manager then
    local fields={}
    for i=0,count-1 do
      local at=entries+0x20+i*L.entrySize
      local hash=readInteger(at)
      if hash and hash&gt;=0 and hash&lt;0x80000000 then
        local keyPtr=pointer(at+8)
        local key=text(keyPtr)
        if fieldName(key) then
          if fields[key] then return nil end
          fields[key]={name=key,index=i,key=keyPtr,slot=at+16}
        end
      end
    end
    M.cache={dict=dict,entries=entries,count=count,version=version,manager=manager,fields=fields}
  end
  local fields=M.cache.fields
  if not fields.playerHealth then return nil end
  for _,f in pairs(fields) do
    if pointer(f.slot-8)~=f.key or text(f.key)~=f.name then M.cache={}; return nil end
    f.object=pointer(f.slot); f.value=text(f.object)
  end
  -- Unused enemy/optional variables can legitimately contain an empty string.
  if not tonumber(fields.playerHealth.value) then return nil end
  if pointer(manager+L.managerMap)~=map or pointer(map+L.mapDictionary)~=dict
    or pointer(dict+L.dictEntries)~=entries or readInteger(dict+L.dictCount)~=count
    or readInteger(dict+L.dictVersion)~=version then M.cache={}; return nil end
  return fields
end
function M.locate()
  if M.discovery~='runtime' then
    local classes={}
    for _,rva in ipairs(M.build.typeInfoCandidates) do
      local klass=pointer(M.base+rva)
      if classIs(klass,'CustomVariableManager','Naninovel') then classes[klass]=true end
    end
    local klass,count=nil,0
    for k in pairs(classes) do klass=k; count=count+1 end
    if count~=1 then error('Expected one initialized CustomVariableManager class, found '..count..'. Load a save first.') end
    M.klass=klass
  end
  if M.manager and M.readFields(M.manager,true) then return M.manager end
  local v=M.klass; local bytes={}
  for i=1,8 do bytes[i]=string.format('%02X', v &amp; 0xFF); v=v &gt;&gt; 8 end
  local found=AOBScan(table.concat(bytes,' '), '+W-C', 1, '8')
  if not found then error('No variable map found. Enter the game first.') end
  local candidates={}
  for i=0,found.Count-1 do
    local at=tonumber(found[i],16)
    local ok,fields=pcall(M.readFields,at,true)
    if ok and fields then candidates[#candidates+1]=at end
  end
  found.destroy(); M.cache={}
  if #candidates~=1 then error('Found '..#candidates..' valid variable maps. Load a save and try Rescan.') end
  return candidates[1]
end
function M.installBridge()
  if M.bridge and M.bridge.pid==M.pid then
    if sameBytes(M.base+UPDATE,M.bridge.patch) and sameBytes(M.base+SANITY_FILTER,M.bridge.sanityPatch) then return end
    error('The write handler has changed. Restart the game and reconnect.')
  end
  if not sameBytes(M.base+UPDATE,ORIGINAL) then error('The Update handler was modified by another tool. Disconnect that tool first.') end
  if not sameBytes(M.base+SANITY_FILTER,SANITY_ORIGINAL) then error('The sanity handler was modified by another tool. Disconnect that tool first.') end
  local asm=([[
[ENABLE]
define(target,%s)
define(setter,%s)
define(newstring,%s)
define(sanityfilter,%s)
assert(target,48 8B 49 20 48 85 C9)
assert(sanityfilter,48 89 5C 24 08)
alloc(anhp_bridge,1000,target)
label(anhp_return)
label(anhp_original)
label(anhp_failure)
label(anhp_restore)
label(anhp_state)
label(anhp_manager)
label(anhp_class)
label(anhp_key)
label(anhp_text)
label(anhp_dict)
label(anhp_entries)
label(anhp_keyslot)
label(anhp_value)
label(anhp_sanity_override)
label(anhp_sanity_hook)
label(anhp_sanity_original)
registersymbol(anhp_state)
registersymbol(anhp_manager)
registersymbol(anhp_class)
registersymbol(anhp_key)
registersymbol(anhp_text)
registersymbol(anhp_dict)
registersymbol(anhp_entries)
registersymbol(anhp_keyslot)
registersymbol(anhp_value)
registersymbol(anhp_sanity_override)
anhp_bridge:
  pushfq
  cmp dword ptr [anhp_state],1
  jne anhp_original
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,88
  movdqu [rsp+20],xmm0
  movdqu [rsp+30],xmm1
  movdqu [rsp+40],xmm2
  movdqu [rsp+50],xmm3
  movdqu [rsp+60],xmm4
  movdqu [rsp+70],xmm5
  mov eax,1
  mov edx,2
  lock cmpxchg [anhp_state],edx
  jne anhp_restore
  mov rcx,[anhp_manager]
  test rcx,rcx
  je anhp_failure
  mov rax,[anhp_class]
  cmp [rcx],rax
  jne anhp_failure
  cmp qword ptr [rcx+%X],0
  jne anhp_failure
  mov rax,[rcx+%X]
  test rax,rax
  je anhp_failure
  mov rax,[rax+%X]
  cmp rax,[anhp_dict]
  jne anhp_failure
  mov rax,[rax+%X]
  cmp rax,[anhp_entries]
  jne anhp_failure
  mov rax,[anhp_keyslot]
  mov rdx,[anhp_key]
  cmp [rax],rdx
  jne anhp_failure
  lea rcx,[anhp_text]
  call newstring
  test rax,rax
  je anhp_failure
  mov [anhp_value],rax
  mov r8,rax
  mov rcx,[anhp_manager]
  mov rdx,[anhp_key]
  xor r9d,r9d
  call setter
  mov dword ptr [anhp_state],3
  jmp anhp_restore
anhp_failure:
  mov dword ptr [anhp_state],FFFFFFFF
anhp_restore:
  movdqu xmm0,[rsp+20]
  movdqu xmm1,[rsp+30]
  movdqu xmm2,[rsp+40]
  movdqu xmm3,[rsp+50]
  movdqu xmm4,[rsp+60]
  movdqu xmm5,[rsp+70]
  add rsp,88
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
anhp_original:
  popfq
  mov rcx,[rcx+20]
  test rcx,rcx
  jmp anhp_return
// Bypass only the fixed-sanity normalizer for this explicit queued write.
// All ordinary game writes and all other variable filters keep their normal behavior.
anhp_sanity_hook:
  pushfq
  cmp dword ptr [anhp_state],2
  jne anhp_sanity_original
  cmp dword ptr [anhp_sanity_override],1
  jne anhp_sanity_original
  cmp rdx,[anhp_key]
  jne anhp_sanity_original
  cmp r8,[anhp_value]
  jne anhp_sanity_original
  popfq
  mov rax,r8
  ret
anhp_sanity_original:
  popfq
  mov [rsp+08],rbx
  jmp sanityfilter+5
align 10
anhp_state:
  dd 0
anhp_sanity_override:
  dd 0
align 8
anhp_manager:
  dq 0
anhp_class:
  dq 0
anhp_key:
  dq 0
anhp_dict:
  dq 0
anhp_entries:
  dq 0
anhp_keyslot:
  dq 0
anhp_value:
  dq 0
anhp_text:
  db 0
target:
  jmp anhp_bridge
  nop 2
anhp_return:
sanityfilter:
  jmp anhp_sanity_hook
[DISABLE]
target:
  db 48 8B 49 20 48 85 C9
sanityfilter:
  db 48 89 5C 24 08
// Leave the single inert page allocated until process exit, avoiding an in-flight return race.
unregistersymbol(anhp_state)
unregistersymbol(anhp_manager)
unregistersymbol(anhp_class)
unregistersymbol(anhp_key)
unregistersymbol(anhp_text)
unregistersymbol(anhp_dict)
unregistersymbol(anhp_entries)
unregistersymbol(anhp_keyslot)
unregistersymbol(anhp_value)
unregistersymbol(anhp_sanity_override)
]]):format(hex(M.base+UPDATE),hex(M.base+SETTER),hex(M.base+STRING_NEW),hex(M.base+SANITY_FILTER),M.build.layout.managerPreview,M.build.layout.managerMap,M.build.layout.mapDictionary,M.build.layout.dictEntries)
  local ok,di=autoAssemble(asm)
  if not ok then error('Could not install the write handler: '..tostring(di)) end
  M.bridge={pid=M.pid,asm=asm,di=di,patch=readBytes(M.base+UPDATE,7,true),sanityPatch=readBytes(M.base+SANITY_FILTER,5,true),
    state=getAddress('anhp_state'),manager=getAddress('anhp_manager'),klass=getAddress('anhp_class'),
    key=getAddress('anhp_key'),dict=getAddress('anhp_dict'),entries=getAddress('anhp_entries'),keyslot=getAddress('anhp_keyslot'),buffer=getAddress('anhp_text'),sanityOverride=getAddress('anhp_sanity_override')}
end
function M.refresh(force)
  M.checkProcess()
  local fields=M.readFields(M.manager,force)
  if not fields then error('The variable map changed. Click Rescan.') end
  M.fields=fields
  local names={}; for k in pairs(fields) do names[#names+1]=k end
  table.sort(names,function(a,b) return order(a)&lt;order(b) end)
  local changed=table.concat(names,',')~=table.concat(M.ordered,',')
  M.ordered=names
  if M.list then
    if changed then
      M.list.Items.clear(); M.selector.Items.clear()
      for _,name in ipairs(names) do
        local item=M.list.Items.add(); item.Caption=name; item.SubItems.add(fields[name].value or '?')
        M.selector.Items.add(name)
      end
      M.selector.ItemIndex=0
      M.valueEdit.Text=fields[names[1]].value or ''
    else
      for i,name in ipairs(names) do M.list.Items[i-1].SubItems[0]=fields[name].value or '?' end
    end
  end
  return fields
end
function M.connect()
  if M.connected then
    local ok=pcall(function() M.checkProcess(); M.refresh(true) end)
    if ok then M.timer.Enabled=true; return true end
  end
  if M.bridge then M.disconnect() end
  M.connected=false; M.timer.Enabled=false; M.manager=nil; M.cache={}; M.build=nil; M.klass=nil; M.discovery=nil
  local pid=getOpenedProcessID()
  local mod=gameModule()
  -- Respect an already attached instance; named metadata identifies the game.
  if not pid or pid==0 or not mod then
    pid=getProcessIDFromProcessName('Annihilated.exe')
    if not pid or pid==0 then error('Start Annihilated through Steam and load a save first.') end
    openProcess(pid); mod=gameModule()
  end
  if not mod then error('GameAssembly.dll is unavailable. Select the game process in CE and check memory access.') end
  if not targetIs64Bit() then error('This table requires the 64-bit game.') end
  M.pid=pid; M.base=mod.Address or getAddressSafe('GameAssembly.dll')
  if not M.base then error('GameAssembly.dll has not loaded yet.') end
  M.ordered={}; M.lastWrite=nil; M.metadataFailure=nil
  M.status('Finding game addresses. Please wait...')
  local ok,reason=pcall(function()
    M.build=Resolver.resolve(M.base,mod.PathToFile)
    M.discovery='metadata'
    local build=M.build
    UPDATE,SETTER,STRING_NEW,SANITY_FILTER=build.update,build.setter,build.stringNew,build.sanityFilter
    M.manager=M.locate(); M.refresh(true)
  end)
  if not ok then
    M.metadataFailure=tostring(reason)
    M.manager=nil; M.cache={}; M.build=nil; M.klass=nil; M.discovery=nil
    local found,why=pcall(function()
      M.discoverRuntime()
      M.manager=M.locate(); M.verifyContainers(M.manager); M.refresh(true)
    end)
    if not found then
      error('Automatic discovery failed. No write handler was installed.\nGame files: '..M.metadataFailure..'\nRuntime: '..tostring(why))
    end
  end
  M.connected=true; M.timer.Enabled=true
  M.status('Connected (PID '..pid..'). Game addresses found automatically.')
  return true
end
function M.requestWrite(name,input)
  M.checkProcess(); if not M.connected then error('Connect to the game first.') end
  if M.pending then error('The previous write is still pending.') end
  local value=tostring(input):match('^%s*(.-)%s*$')
  if not value:match('^%-?%d+$') then error('Enter a whole number.') end
  local number=tonumber(value)
  if not number or number &lt; -2147483648 or number &gt; 2147483647 then error('The value must fit in a signed 32-bit integer.') end
  if name:find('MaxHealth',1,true) and number&lt;1 then error('Maximum HP must be at least 1.') end
  value=string.format('%.0f',number)
  local fields=M.refresh(true); local f=fields[name]
  if not f or not fieldName(name) then error('This field is not available in the current state.') end
  if pointer(M.manager+M.build.layout.managerPreview)~=0 then error('The game is evaluating a preview. Try again shortly.') end
  M.installBridge(); local b=M.bridge
  if readInteger(b.state)==2 then error('The game is processing the previous request. Try again shortly.') end
  put(writeInteger(b.state,0))
  put(writeInteger(b.sanityOverride,(name=='playerSanity' or name=='partnerSanity') and 1 or 0))
  put(writeQword(b.manager,M.manager)); put(writeQword(b.klass,M.klass)); put(writeQword(b.key,f.key))
  put(writeQword(b.dict,M.cache.dict)); put(writeQword(b.entries,M.cache.entries)); put(writeQword(b.keyslot,f.slot-8))
  put(writeString(b.buffer,value,false)); put(writeBytes(b.buffer+#value,0))
  M.pending={name=name,before=f.value,desired=value,started=getTickCount()}
  put(writeInteger(b.state,1))
  M.status('Waiting for the next game frame: '..name..' = '..value)
end
function M.poll()
  if not M.connected then return end
  M.checkProcess()
  if M.pending then
    local state=readInteger(M.bridge.state)
    if state==3 then
      local task=M.pending; M.pending=nil; put(writeInteger(M.bridge.state,0))
      M.refresh(true)
      local actual=M.fields[task.name] and M.fields[task.name].value
      M.lastWrite={name=task.name,before=task.before,desired=task.desired,actual=actual}
      if actual~=task.desired then error('The game returned '..tostring(actual)..'; requested '..task.desired..'.') end
      M.status('Updated '..task.name..': '..task.before..' -&gt; '..actual)
    elseif state==0xFFFFFFFF or state==-1 then
      M.pending=nil; put(writeInteger(M.bridge.state,0)); error('Preview is active or the variable map changed. Click Rescan.')
    elseif getTickCount()-M.pending.started&gt;10000 and state==1 then
      -- Claim cancellation atomically on the game thread would require another bridge command;
      -- keep the single request pending so it cannot be silently requeued or overwritten.
      M.status('Return to the game window to process the pending write. No duplicate request was sent.')
    end
  else M.refresh(false) end
  if M.testStep then M.testStep() end
end
function M.disconnect()
  -- The game may have exited while CE stayed open or attached to its replacement.
  -- Only discard the old bridge when a successful process listing proves it gone.
  if M.bridge and type(getProcesslist)=='function' then
    local ok,processes=pcall(getProcesslist)
    if ok and type(processes)=='table' and next(processes)~=nil and not processes[M.bridge.pid] then
      M.bridge=nil
    end
  end
  if M.bridge and getOpenedProcessID()==M.bridge.pid and not gameModule() then M.bridge=nil end
  if M.bridge then
    if getOpenedProcessID()~=M.bridge.pid then error('Select Annihilated.exe in CE again before disconnecting the write handler.') end
    local state=readInteger(M.bridge.state)
    if state==1 or state==2 then error('A write is pending. Return to the game for a frame before disconnecting.') end
    if sameBytes(M.base+UPDATE,M.bridge.patch) and sameBytes(M.base+SANITY_FILTER,M.bridge.sanityPatch) then
      local ok,err=autoAssemble(M.bridge.asm,false,M.bridge.di)
      if not ok then error('Could not restore the game handler: '..tostring(err)) end
    elseif not sameBytes(M.base+UPDATE,ORIGINAL) or not sameBytes(M.base+SANITY_FILTER,SANITY_ORIGINAL) then error('A game handler was modified by another tool; its changes were not overwritten.') end
    M.bridge=nil
  end
  if M.timer then M.timer.Enabled=false end
  M.connected=false; M.pending=nil; M.manager=nil; M.cache={}
  M.status('Disconnected. Game function entries restored.')
end
function M.guarded(fn)
  return function(...)
    local ok,err=pcall(fn,...)
    if not ok then M.status(tostring(err)); showMessage(tostring(err)) end
  end
end
function M.show() M.form.show() end

local form=createForm(false); M.form=form
form.Caption='Annihilated - HP, Sanity &amp; Curse Editor'
form.Position='poScreenCenter'; form.Font.Name='Segoe UI'; form.Font.Size=10
-- CE scales fonts with Windows DPI; scale manually positioned controls to match.
local scale=math.max(1,math.abs(form.Font.Height)/14)
local function U(n) return math.floor(n*scale+0.5) end
form.Width=U(640); form.Height=U(510)
local function label(caption,x,y,w)
  local c=createLabel(form); c.Caption=caption; c.AutoSize=false; c.Left=U(x); c.Top=U(y); c.Width=U(w); c.Height=U(24); return c
end
local function button(caption,x,y,w,fn)
  local c=createButton(form); c.Caption=caption; c.Left=U(x); c.Top=U(y); c.Width=U(w); c.Height=U(32); c.OnClick=M.guarded(fn); return c
end
label('Load a save &gt; Connect &gt; Select a field &gt; Apply',16,14,600)
button('1. Connect',16,44,140,M.connect)
button('Rescan',168,44,120,function()
  M.checkProcess(); if M.pending then error('Wait for the pending write to finish.') end
  M.manager=nil; M.cache={}; M.lastWrite=nil; M.manager=M.locate(); if M.discovery=='runtime' then M.verifyContainers(M.manager) end; M.refresh(true); M.status('Located HP, sanity and curse fields in the current save.')
end)
button('Disconnect',300,44,90,M.disconnect)
local list=createListView(form); M.list=list
list.Left=U(16); list.Top=U(90); list.Width=U(590); list.Height=U(220)
list.ViewStyle='vsReport'; list.RowSelect=true; list.ReadOnly=true; list.HideSelection=false
local col=list.Columns.add(); col.Caption='Field'; col.Width=U(390)
col=list.Columns.add(); col.Caption='Current value'; col.Width=U(150)
list.OnClick=function()
  if list.ItemIndex&gt;=0 then M.selector.ItemIndex=list.ItemIndex; M.valueEdit.Text=M.fields[M.ordered[list.ItemIndex+1]].value or '' end
end
local combo=createComboBox(form); M.selector=combo
combo.Left=U(16); combo.Top=U(328); combo.Width=U(330); combo.Style='csDropDownList'
local edit=createEdit(form); M.valueEdit=edit; edit.Left=U(360); edit.Top=U(328); edit.Width=U(100)
combo.OnChange=function() local name=M.ordered[combo.ItemIndex+1]; if name and M.fields[name] then edit.Text=M.fields[name].value or '' end end
button('2. Apply',474,324,132,function()
  local name=M.ordered[combo.ItemIndex+1]; if not name then error('Select a field first.') end
  M.requestWrite(name,edit.Text)
end)
button('Full Player HP',16,368,140,function() M.requestWrite('playerHealth',M.fields.playerMaxHealth and M.fields.playerMaxHealth.value or '') end)
button('Undo Last Write',168,368,150,function()
  if not M.lastWrite then error('There is no successful write to undo.') end
  M.requestWrite(M.lastWrite.name,M.lastWrite.before)
end)
M.statusLabel=label('Disconnected. Enter the game or load a save first.',16,416,590)
M.statusLabel.Height=U(48); M.statusLabel.WordWrap=true
M.timer=createTimer(form,false); M.timer.Interval=300
M.timer.OnTimer=function()
  local ok,err=pcall(M.poll)
  if not ok then M.status(tostring(err)); M.timer.Enabled=false end
end
form.OnClose=function()
  local ok,err=pcall(M.disconnect)
  if not ok then M.status(tostring(err)); return caNone end
  return caHide
end
M.show()
</LuaScript>
</CheatTable>
